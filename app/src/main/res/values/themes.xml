<resources>
    <!-- 플레오스 심플(PM 2026-10-26): 흰 바탕 · 검정 글자 · 얇은 선 아이콘 · 둥근 카드. 밤은 values-night 색으로 자동(AAOS 야간 모드) -->
    <style name="Theme.ParkingCoach" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:buttonStyle">@style/Btn</item>
        <item name="colorControlNormal">@color/fg</item>
        <item name="android:textColorHint">@color/fg3</item>
    </style>
    <style name="Btn" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Btn.Pri">
        <item name="android:background">@drawable/bg_btn_pri</item>
        <item name="android:textColor">@color/inkFg</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- 독: 선 아이콘 위 · 작은 글자 아래. 선택은 setSelected + 배경 -->
    <style name="Dock" parent="Btn">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/dock_text</item>
        <item name="android:textSize">10sp</item>
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:drawableTint">@color/dock_text</item>
        <item name="android:gravity">center_horizontal|top</item>
    </style>
    <style name="Label">
        <item name="android:background">@drawable/bg_label</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">11dp</item>
        <item name="android:paddingRight">11dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>
    <style name="Label.Info">
        <item name="android:textColor">@color/fg2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <!-- 가상 기어 글자: 꺼짐 = 연한 회색, 켜짐 = 검정 네모 안 흰 글자(setBg) -->
    <style name="GearBtn" parent="Btn">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
    </style>
</resources>
