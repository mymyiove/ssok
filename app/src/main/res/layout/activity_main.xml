<?xml version="1.0" encoding="utf-8"?>
<!-- 플레오스 심플(PM 2026-10-26) = 시안 v4: 왼쪽 독(선 아이콘) · 위 상태 바 · 위 줄 [후방/전방 카메라(크게)][어라운드뷰] · 아래 줄 [왼쪽 미러][핸들 클러스터][오른쪽 미러].
     색은 전부 @color 토큰(values / values-night). 오버레이: 홈 · 결과 · 팁 · 거울 맞추기 · P 가드 · 오프닝 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:clipChildren="false">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false" android:clipChildren="false">
        <!-- 독 -->
        <LinearLayout android:id="@+id/dock" android:layout_width="64dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:background="@color/bg" android:paddingTop="12dp" android:paddingBottom="10dp">
            <TextView android:text="쏙" android:textColor="@color/fg" android:textSize="22sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <Button android:id="@+id/dHome" style="@style/Dock" android:text="홈" android:drawableTop="@drawable/ic_home"/>
            <Button android:id="@+id/dPlay" style="@style/Dock" android:text="연습" android:drawableTop="@drawable/ic_play" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/dLb" style="@style/Dock" android:text="기록" android:drawableTop="@drawable/ic_flag" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/dTips" style="@style/Dock" android:text="팁" android:drawableTop="@drawable/ic_bulb" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/dMir" style="@style/Dock" android:text="거울" android:drawableTop="@drawable/ic_mirror" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/dHelp" style="@style/Dock" android:text="도움말" android:drawableTop="@drawable/ic_help" android:layout_marginTop="4dp"/>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            <Button android:id="@+id/dSound" style="@style/Dock" android:text="소리" android:drawableTop="@drawable/ic_sound"/>
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:clipChildren="false">
            <!-- 위 상태 바 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/bg" android:paddingLeft="16dp" android:paddingRight="16dp">
                <TextView android:text="쏙" android:textColor="@color/fg" android:textSize="15sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="주차 연습" android:textColor="@color/fg" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp"/>
                <TextView android:id="@+id/stageName" android:textColor="@color/fg2" android:textSize="13sp" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="14dp" android:layout_marginRight="14dp"/>
                <Button android:id="@+id/demoBtn" android:text="시연" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="32dp"/>
                <Button android:id="@+id/hintBtn" android:text="힌트" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginLeft="4dp" android:visibility="gone"/>
                <Button android:id="@+id/resetBtn" android:text="다시" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/moreBtn" android:text="⋯" android:textSize="14sp" android:layout_width="38dp" android:layout_height="32dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:layout_marginLeft="4dp"/>
                <Button android:id="@+id/coachBtn" android:text="코치 켬" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginLeft="4dp" android:visibility="gone"/>
                <Button android:id="@+id/guideBtn" android:text="가이드라인" android:textSize="12sp" android:background="@drawable/bg_btn_on" android:textColor="@color/inkFg" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginLeft="4dp" android:visibility="gone"/>
                <Button android:id="@+id/tourBtn" android:text="화면 안내" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginLeft="4dp" android:visibility="gone"/>
                <Button android:id="@+id/dipBtn" android:text="R 미러 양쪽" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginLeft="4dp" android:visibility="gone"/>
                <TextView android:id="@+id/clock" android:layout_marginLeft="14dp" android:textColor="@color/fg" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>

            <!-- 위 줄: 카메라(크게) + 어라운드뷰 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.55" android:orientation="horizontal" android:baselineAligned="false" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="12dp">
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="@drawable/bg_pane" android:clipToOutline="true">
                    <app.parkingcoach.render.CameraView android:id="@+id/cam" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <TextView android:id="@+id/camLabel" style="@style/Label" android:text="후방 카메라" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="12dp"/>
                    <TextView android:id="@+id/camInfo" style="@style/Label.Info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="12dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="bottom|end" android:layout_marginRight="14dp" android:layout_marginBottom="62dp">
                        <View android:id="@+id/pdw3" android:layout_width="30dp" android:layout_height="6dp" android:background="@color/muted2" android:layout_marginBottom="3dp"/>
                        <View android:id="@+id/pdw2" android:layout_width="30dp" android:layout_height="6dp" android:background="@color/muted2" android:layout_marginBottom="3dp"/>
                        <View android:id="@+id/pdw1" android:layout_width="30dp" android:layout_height="6dp" android:background="@color/muted2"/>
                    </LinearLayout>
                    <TextView android:id="@+id/hazBanner" android:background="@drawable/bg_haz_banner" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|top" android:layout_marginTop="90dp" android:visibility="gone"/>
                    <TextView android:id="@+id/toast" android:background="@drawable/bg_toast" android:textColor="@color/inkFg" android:textSize="13sp" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
                    <LinearLayout android:id="@+id/demoBar" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_demo_bar" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:layout_marginTop="48dp" android:visibility="gone">
                        <TextView android:text="시연" android:background="@drawable/bg_pill" android:textColor="@color/inkFg" android:textSize="10sp" android:textStyle="bold" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/demoCap" android:textColor="@color/fg" android:textSize="14sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_marginRight="10dp"/>
                        <Button android:id="@+id/demoStop" android:text="직접 하기" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="32dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/coach" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:background="@drawable/bg_coach" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom">
                        <TextView android:id="@+id/step" android:background="@drawable/bg_pill" android:textColor="@color/inkFg" android:textSize="11sp" android:textStyle="bold" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="10dp"/>
                        <TextView android:id="@+id/hintTxt" android:textColor="@color/fg" android:textSize="16sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:layout_marginLeft="12dp" android:background="@drawable/bg_pane" android:clipToOutline="true">
                    <app.parkingcoach.render.TopView android:id="@+id/topView" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <TextView style="@style/Label" android:text="어라운드뷰" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="12dp"/>
                    <TextView android:id="@+id/topInfo" style="@style/Label.Info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="12dp"/>
                </FrameLayout>
            </LinearLayout>

            <!-- 아래 줄(PM 2026-10-26 '진짜 차처럼'): 왼쪽 미러 · [슬림 클러스터 패널 / 비상등 · 핸들(+아래 넓은 브레이크 페달) · 컬럼 레버] · 오른쪽 미러. 미러 유리 위 = 패널 위, 아래 = 페달 아래 -->
            <LinearLayout android:id="@+id/bottom" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="10dp" android:clipChildren="false" android:clipToPadding="false">
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7">
                    <app.parkingcoach.render.MirrorView android:id="@+id/mirL" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <TextView style="@style/Label" android:text="왼쪽 미러" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="12dp"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:orientation="vertical" android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:clipChildren="false" android:clipToPadding="false">
                    <app.parkingcoach.render.ClusterView android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="72dp"/>
                    <!-- 아래 칸(PM 2026-10-26 그림): [핸들(크게, 왼손)] [컬럼 레버] [비상등 위 / 브레이크 아래(오른손, 좌→우)] -->
                    <!-- 세 덩어리(핸들 · 레버 · 비상등+브레이크)가 같은 위선(패널 아래 10dp)·아랫선(줄 바닥 = 미러 바닥)을 쓴다 -->
                    <LinearLayout android:id="@+id/deck" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:paddingTop="10dp" android:clipChildren="false" android:clipToPadding="false">
                        <app.parkingcoach.render.WheelView android:id="@+id/wheel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
                        <!-- 기어(PM 그림): ▲ · D N R 블록 · ▼ -->
                        <LinearLayout android:orientation="vertical" android:layout_width="64dp" android:layout_height="match_parent" android:layout_marginLeft="12dp" android:layout_marginRight="12dp">
                            <Button android:id="@+id/gUp" android:text="▲" android:textSize="13sp" android:layout_width="match_parent" android:layout_height="34dp" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp"/>
                            <app.parkingcoach.render.StalkView android:id="@+id/stalk" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginBottom="6dp"/>
                            <Button android:id="@+id/gDn" android:text="▼" android:textSize="13sp" android:layout_width="match_parent" android:layout_height="34dp" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp"/>
                        </LinearLayout>
                        <!-- 오른손: 윗줄 [P][비상등][⏮ ▶ ⏭] · 아랫줄 브레이크(좌 → 우) -->
                        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1.25" android:layout_height="match_parent">
                            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="4" android:baselineAligned="false">
                                <Button android:id="@+id/pBtn" android:text="P" android:textSize="20sp" android:textStyle="bold" android:textColor="#F4F5F7" android:background="@drawable/bg_pbtn" android:layout_width="64dp" android:layout_height="match_parent" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp"/>
                                <Button android:id="@+id/hazBtn" android:text="비상등" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_haz_btn" android:drawableLeft="@drawable/ic_hazard" android:drawableTint="@color/fg" android:drawablePadding="8dp" android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="0dp" android:layout_marginLeft="8dp"/>
                                <!-- 라디오 카드(PM 2026-10-27): 위 곡 이름 · 아래 ⏮ ▶ ⏭ 한 장 -->
                                <LinearLayout android:orientation="vertical" android:background="@drawable/bg_radio" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="7dp" android:paddingBottom="6dp" android:layout_width="0dp" android:layout_weight="1.15" android:layout_height="match_parent" android:layout_marginLeft="8dp">
                                    <TextView android:id="@+id/mTitle" android:text="음악 꺼짐" android:textColor="@color/fg" android:textSize="11sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:drawableLeft="@drawable/ic_dot" android:drawablePadding="6dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="26dp">
                                        <Button android:id="@+id/mPrev" android:text="⏮" android:textSize="12sp" android:background="@drawable/bg_rbtn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp"/>
                                        <Button android:id="@+id/mPlay" android:text="▶" android:textSize="12sp" android:background="@drawable/bg_rbtn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:layout_marginLeft="4dp"/>
                                        <Button android:id="@+id/mNext" android:text="⏭" android:textSize="12sp" android:background="@drawable/bg_rbtn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:layout_marginLeft="4dp"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <app.parkingcoach.render.BrakeBarView android:id="@+id/brake" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="6" android:layout_marginTop="10dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7">
                    <app.parkingcoach.render.MirrorView android:id="@+id/mirR" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <TextView style="@style/Label" android:text="오른쪽 미러" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="12dp"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 기어 가드: 실차에서 P 가 아니면 -->
    <TextView android:id="@+id/gate" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:background="@color/scrim" android:textColor="@color/fg" android:textSize="22sp" android:visibility="gone"/>

    <!-- 홈(스테이지 고르기) -->
    <LinearLayout android:id="@+id/setup" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@color/bg" android:layout_marginLeft="65dp" android:baselineAligned="false" android:clickable="true">
        <ScrollView android:layout_width="300dp" android:layout_height="match_parent" android:background="@color/bg" android:scrollbars="none">
            <LinearLayout android:id="@+id/stageList" android:orientation="vertical" android:padding="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </ScrollView>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line"/>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ScrollView android:id="@+id/paneScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
                <LinearLayout android:orientation="vertical" android:padding="20dp" android:paddingBottom="80dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/setupTitle" android:textColor="@color/fg" android:textSize="22sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/setupNote" android:textColor="@color/fg2" android:textSize="13sp" android:lineSpacingMultiplier="1.35" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <TextView android:text="내 차" android:textColor="@color/fg2" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="10dp"/>
                        <Button android:id="@+id/carAvante" android:text="아반떼" android:layout_width="wrap_content" android:layout_height="34dp"/>
                        <Button android:id="@+id/carGrandeur" android:text="그랜저" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginLeft="4dp"/>
                        <Button android:id="@+id/carTucson" android:text="투싼" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginLeft="4dp"/>
                    </LinearLayout>
                    <app.parkingcoach.render.TopView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="12dp" android:background="@drawable/bg_pane"/>
                    <LinearLayout android:id="@+id/freeOpts" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone">
                        <Spinner android:id="@+id/fKind" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <Spinner android:id="@+id/fTier" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <Spinner android:id="@+id/fNeigh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <Spinner android:id="@+id/fSide" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                        <Spinner android:id="@+id/fHaz" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                        <TextView android:id="@+id/lbTitle" android:text="기록 TOP 5" android:textSize="11sp" android:textColor="@color/fg3" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/lbBody" android:textColor="@color/fg" android:textSize="13sp" android:fontFamily="monospace" android:lineSpacingMultiplier="1.4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <TextView android:text="쏙 공식: 신호(비상등, 밟은 채 D) → 자리(지나쳐 멈추고 밟은 채 R) → 돌리기(서서 핸들 끝까지) → 끝(나란히, 브레이크, N). 기어는 브레이크를 밟아야 들어가고, 가속 페달은 없습니다. 기록 = 시간 + 실수(충돌 5초 · 사고 15초 · 보정 3초 · 비상등 안 켬 2초). 핸들을 끝까지 돌린 채 오래 잡지 마세요." android:textColor="@color/fg3" android:textSize="12sp" android:lineSpacingMultiplier="1.35" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
                </LinearLayout>
            </ScrollView>
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card" android:padding="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="14dp">
                <Button android:id="@+id/startBtn" style="@style/Btn.Pri" android:text="시작" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="40dp" android:paddingLeft="22dp" android:paddingRight="22dp"/>
                <Button android:id="@+id/startDemo" android:text="시연 먼저 보기" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginLeft="8dp"/>
                <TextView android:id="@+id/seedTxt" android:textColor="@color/fg3" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 초보 팁 -->
    <FrameLayout android:id="@+id/tips" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:layout_marginLeft="65dp" android:visibility="gone" android:clickable="true">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:id="@+id/tipsTxt" android:padding="24dp" android:paddingBottom="80dp" android:textColor="@color/fg" android:textSize="14sp" android:lineSpacingMultiplier="1.45" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </ScrollView>
        <Button android:id="@+id/tipsClose" android:text="닫기" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="14dp"/>
    </FrameLayout>

    <!-- 도움말 페이지(PM 2026-10-27) -->
    <FrameLayout android:id="@+id/help" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:layout_marginLeft="65dp" android:visibility="gone" android:clickable="true">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:id="@+id/helpTxt" android:padding="24dp" android:paddingBottom="80dp" android:textColor="@color/fg" android:textSize="14sp" android:lineSpacingMultiplier="1.45" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </ScrollView>
        <Button android:id="@+id/helpClose" android:text="닫기" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="14dp"/>
    </FrameLayout>

    <!-- 첫 진입 화면 안내: 번호 표식 + 가운데 설명 카드 + 오른쪽 위 ✕ -->
    <FrameLayout android:id="@+id/tour" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#85000000" android:layout_marginLeft="65dp" android:visibility="gone" android:clickable="true">
        <app.parkingcoach.render.TourMarksView android:id="@+id/tourMarks" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_width="720dp" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="64dp">
            <TextView android:text="화면 안내" android:textColor="@color/fg" android:textSize="17sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tourList" android:textColor="@color/fg" android:textSize="13sp" android:lineSpacingMultiplier="1.35" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
            <LinearLayout android:orientation="horizontal" android:gravity="right" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                <Button android:id="@+id/tourHelp" android:text="자세한 도움말 ›" android:layout_width="wrap_content" android:layout_height="36dp"/>
                <Button android:id="@+id/tourOk" style="@style/Btn.Pri" android:text="알겠어요" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginLeft="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/tourX" android:text="✕" android:textSize="16sp" android:layout_width="40dp" android:layout_height="40dp" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:layout_gravity="top|end" android:layout_margin="12dp"/>
    </FrameLayout>

    <!-- 거울 맞추기 -->
    <FrameLayout android:id="@+id/mirprac" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/scrimDone" android:layout_marginLeft="65dp" android:visibility="gone" android:clickable="true">
        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_width="720dp" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="64dp">
            <TextView android:text="거울 맞추기" android:textColor="@color/fg" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="오른쪽 사이드미러를 끌어서 각도를 맞춰 보세요. 뒷바퀴와 주차선이 같이 보이면 통과. ← → 바깥·안쪽 · ↑ ↓ 위·아래" android:textColor="@color/fg2" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:baselineAligned="false">
                <app.parkingcoach.render.MirrorView android:id="@+id/mpMirror" android:layout_width="408dp" android:layout_height="240dp" android:background="@drawable/bg_pane"/>
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="14dp">
                    <TextView android:id="@+id/mp1" android:text="1  차체가 안쪽 1/4~1/5 만 보여요" android:textSize="13sp" android:textColor="@color/fg2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/mp2" android:text="2  뒷바퀴가 보여요(거울을 아래로)" android:textSize="13sp" android:textColor="@color/fg2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/mp3" android:text="3  옆 칸 주차선이 보여요" android:textSize="13sp" android:textColor="@color/fg2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
                    <TextView android:id="@+id/mpAngle" android:textSize="12sp" android:textColor="@color/fg2" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/mpPass" android:textSize="13sp" android:textColor="@color/green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <Button android:id="@+id/mpUsual" android:text="평소 각도로" android:layout_width="wrap_content" android:layout_height="36dp"/>
                <Button android:id="@+id/mpPark" android:text="주차 각도로" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginLeft="6dp"/>
                <Button android:id="@+id/mpReset" android:text="흐트러뜨리기" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginLeft="6dp"/>
                <Button android:id="@+id/mpClose" style="@style/Btn.Pri" android:text="닫기" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginLeft="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 결과 -->
    <FrameLayout android:id="@+id/done" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/scrimDone" android:layout_marginLeft="65dp" android:visibility="gone" android:clickable="true">
        <ScrollView android:layout_width="760dp" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/bg_card" android:scrollbars="none">
            <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/doneTitle" android:textColor="@color/fg" android:textSize="22sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/doneTxt" android:textColor="@color/fg2" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/gapsTxt" android:textColor="@color/fg" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                <LinearLayout android:orientation="horizontal" android:gravity="bottom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <TextView android:id="@+id/recBig" android:textColor="@color/fg" android:textSize="36sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/recPen" android:textColor="@color/fg2" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_marginBottom="7dp"/>
                    <TextView android:id="@+id/recClean" android:text="CLEAN" android:textColor="#FFFFFF" android:background="@drawable/bg_btn_pri" android:backgroundTint="@color/green" android:textSize="11sp" android:textStyle="bold" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_marginBottom="7dp" android:visibility="gone"/>
                    <TextView android:id="@+id/recRank" android:textColor="@color/fg2" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_marginBottom="7dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/nameRow" android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:text="이름" android:textColor="@color/fg2" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="8dp"/>
                    <EditText android:id="@+id/nameIn" android:hint="HJ" android:maxLength="8" android:inputType="textCapCharacters" android:background="@drawable/bg_input" android:textColor="@color/fg" android:padding="8dp" android:textSize="14sp" android:layout_width="110dp" android:layout_height="36dp"/>
                    <Button android:id="@+id/saveRec" android:text="기록 저장" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginLeft="8dp"/>
                    <TextView android:id="@+id/saveMsg" android:textColor="@color/fg3" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"/>
                </LinearLayout>
                <TextView android:id="@+id/review" android:textColor="@color/fg" android:textSize="13sp" android:lineSpacingMultiplier="1.5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <app.parkingcoach.render.ReplayView android:id="@+id/replay" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="8dp" android:background="@drawable/bg_pane"/>
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                    <Button android:id="@+id/rpPlay" android:text="▶ 다시 보기" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="30dp"/>
                    <TextView android:text="탑뷰 리플레이 · 파란 실선 = 내 궤적 · 점선 = 공식 궤적(같은 상황을 시연 운전자가 간 길)" android:textColor="@color/fg2" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"/>
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <Button android:id="@+id/again" android:text="같은 상황 다시" android:layout_width="wrap_content" android:layout_height="38dp"/>
                    <Button android:id="@+id/againNew" android:text="새 상황" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginLeft="8dp"/>
                    <Button android:id="@+id/next" style="@style/Btn.Pri" android:text="다음 스테이지 ▶" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginLeft="8dp"/>
                    <Button android:id="@+id/toMenu" android:text="홈" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginLeft="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 오프닝 -->
    <LinearLayout android:id="@+id/opening" android:orientation="vertical" android:gravity="center" android:background="@color/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true">
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="쏙" android:textSize="56sp" android:textStyle="bold" android:textColor="@color/fg" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="SSOK" android:textSize="56sp" android:textStyle="bold" android:textColor="@color/accent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="14dp"/>
        </LinearLayout>
        <TextView android:text="Signal · Stop · Orbit · Keep — 쏙하고 들어오면 주차 끝!" android:textColor="@color/fg2" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <TextView android:text="세워 둔 내 차 안에서, 내 차 핸들로" android:textColor="@color/fg3" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
        <TextView android:text="아무 데나 누르면 시작" android:textColor="@color/fg3" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="40dp"/>
    </LinearLayout>
</FrameLayout>
