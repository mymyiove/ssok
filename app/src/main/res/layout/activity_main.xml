<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/panes"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:baselineAligned="false">
        <app.parkingcoach.render.RearCamView android:id="@+id/rearCam"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
        <app.parkingcoach.render.TopView android:id="@+id/topView"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
    </LinearLayout>
    <TextView android:id="@+id/hud"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_margin="12dp"
        android:padding="8dp" android:background="#99000000" android:textSize="14sp"
        android:fontFamily="monospace"/>
    <TextView android:id="@+id/hint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_margin="16dp"
        android:padding="10dp" android:background="#CC1B1F2A" android:textSize="18sp"/>
    <TextView android:id="@+id/gate"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:background="#E6000000" android:textSize="22sp"
        android:visibility="gone"/>

    <!-- 시작 화면: 차종·코스 고르기 -->
    <LinearLayout android:id="@+id/setup"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:background="#F20E0F12" android:padding="24dp">
        <TextView android:text="쏙" android:textSize="48sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Stop · Steer · See · OK\n세워 둔 내 차 안에서, 내 차 핸들로 주차 연습" android:gravity="center" android:textColor="#9AA3B2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>
        <TextView android:text="내 차" android:textColor="#9AA3B2" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <RadioGroup android:id="@+id/carGroup" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/carAvante" android:text="디 올 뉴 아반떼" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/carGrandeur" android:text="더 뉴 그랜저" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RadioGroup>
        <TextView android:text="코스" android:textColor="#9AA3B2" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <RadioGroup android:id="@+id/courseGroup" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
            <RadioButton android:id="@+id/coursePerp" android:text="후면 직각주차" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/coursePillar" android:text="기둥 옆" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/courseParallel" android:text="평행주차" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RadioGroup>
        <Button android:id="@+id/startBtn" android:text="시작 (기어 P 확인)" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="핸들을 가득 돌린 채 오래 잡고 있지 마세요. 한 번에 5분까지." android:textColor="#9AA3B2" android:textSize="12sp" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- 완료 화면: 리플레이 -->
    <LinearLayout android:id="@+id/done"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:background="#F215181F" android:padding="12dp" android:visibility="gone">
        <TextView android:id="@+id/doneTxt" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <app.parkingcoach.render.ReplayView android:id="@+id/replay" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="8dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <Button android:id="@+id/retryBtn" android:text="다시" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/nextBtn" android:text="다음 코스" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/simPanel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="12dp" android:padding="8dp"
        android:background="#99000000" android:orientation="vertical" android:visibility="gone">
        <TextView android:text="시뮬레이터 입력 (Pleos 서비스 없음)" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp"/>
        <SeekBar android:id="@+id/simSteer" android:layout_width="260dp" android:layout_height="wrap_content" android:max="1080" android:progress="540"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <Button android:id="@+id/simLeft" android:text="◀ 전진" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/simOff" android:text="OFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/simRight" android:text="후진 ▶" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <ToggleButton android:id="@+id/simBrake" android:textOn="브레이크 ON" android:textOff="브레이크 OFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <ToggleButton android:id="@+id/simGear" android:textOn="기어 D" android:textOff="기어 P" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/simReset" android:text="다시" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
