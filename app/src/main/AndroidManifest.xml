<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pleos Vehicle SDK: 조향각·브레이크·기어 = CAR_DRIVE, 방향지시등 = CAR_LIGHTS. 제어(CONTROL_*)·카메라 없음 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.ParkingCoach"
        android:allowBackup="false">
        <!-- 정차 전용 앱: DO(distraction optimized) 미선언 → P 이탈 시 시스템이 종료/숨김 (Pleos 미디어 앱 정책) -->
        <meta-data android:name="distractionOptimized" android:value="false" />
        <activity android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
