<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pleos Vehicle SDK: 조향각·브레이크·기어 = CAR_DRIVE, 방향지시등 = CAR_LIGHTS. 제어(CONTROL_*)·카메라 없음 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- AAOS 표준 기어 상태(GEAR_SELECTION) 읽기: Pleos SDK가 Gear 도메인을 deprecated 로 표시해 Google 속성으로 폴백 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- AAOS 표준 비상등 상태(HAZARD_LIGHTS_STATE) 읽기: Pleos SDK TurnSignal 은 OFF/LEFT/RIGHT 뿐이라 비상등은 이 속성으로 -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_logo"
        android:theme="@style/Theme.ParkingCoach"
        android:allowBackup="false">
        <!-- 정차 전용 앱: DO(distraction optimized) 미선언 → P 이탈 시 시스템이 종료/숨김 (Pleos 미디어 앱 정책) -->
        <uses-library android:name="android.car" android:required="false" />
        <meta-data android:name="distractionOptimized" android:value="false" />
        <activity android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
